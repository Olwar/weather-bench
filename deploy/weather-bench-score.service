[Unit]
Description=weather-bench rebuild blends and rescore

[Service]
Type=oneshot
WorkingDirectory=/opt/weather-bench
Environment=WEATHERBENCH_DATA=/opt/weather-bench/data
# The trailing wipe deletes the derived blend rows once scored - they are
# rebuilt from members on the next run, and leaving ~7M derived rows in the DB
# all day would inflate growth and backups by ~40% for nothing.
ExecStart=/bin/sh -c "/opt/weather-bench/.venv/bin/python /opt/weather-bench/blend.py && /opt/weather-bench/.venv/bin/python /opt/weather-bench/score.py > /opt/weather-bench/data/score_board.txt && /opt/weather-bench/.venv/bin/python /opt/weather-bench/agent_stats.py && /opt/weather-bench/.venv/bin/python /opt/weather-bench/blend.py --wipe-only"
MemoryMax=2G
Nice=10
# Idle I/O class: the site's reads must win over the nightly full-table
# passes on the slow volume (a cold per-city read took 71 s without this).
IOSchedulingClass=idle
