[Unit]
Description=weather-bench rebuild blends and rescore

[Service]
Type=oneshot
WorkingDirectory=/opt/weather-bench
Environment=WEATHERBENCH_DATA=/opt/weather-bench/data
# Blends are derived in memory by score.py since 2026-09-20; nothing writes
# to the DB here. (Until then blend.py materialised them as rows every night
# and a trailing wipe deleted them: 57M rows/day of churn, 2.5 h of the run.)
ExecStart=/bin/sh -c "/opt/weather-bench/.venv/bin/python /opt/weather-bench/score.py > /opt/weather-bench/data/score_board.txt && /opt/weather-bench/.venv/bin/python /opt/weather-bench/agent_stats.py"
MemoryMax=2G
Nice=10
# Idle I/O class: the site's reads must win over the nightly full-table
# passes on the slow volume (a cold per-city read took 71 s without this).
IOSchedulingClass=idle
