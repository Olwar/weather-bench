{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/web/static/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://89.167.5.149:8080/api/:path*"
    },
    {
      "source": "/",
      "destination": "/web/static/index.html"
    }
  ]
}
